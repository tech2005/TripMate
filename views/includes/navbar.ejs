<style>
  .btn-search {
    background-color: rgb(18, 151, 151);
    color: #fff;
    padding: 4px 12px; 
    display: flex;
    align-items: center;
    gap: 6px; 
    white-space: nowrap; 
    border-radius: 2rem;
  }
  .btn-search:hover {
    background-color: rgb(16, 130, 130);
    color: #fff;
  }
  .search .form-control {
    height: 34px; 
    font-size: 1rem;
    border-radius: 2rem;
    padding: 0 1rem;
  }
</style>

<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">
  <div class="container-fluid">
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup">
      <span class="navbar-toggler-icon"></span>
    </button>
    
    <a class="navbar-brand" href="/listings">
      <i class="fa-solid fa-suitcase-rolling"></i> TripMate
    </a>

    <div class="navbar-nav ms-auto search">
      <form class="d-flex align-items-center" action="/listings" method="GET">
        <input class="form-control me-2" type="search" placeholder="Your destination" aria-label="Search">
        <button class="btn btn-search" type="submit">
          <i class="fa-solid fa-magnifying-glass"></i> Search
        </button>
      </form>
    </div>

    <div class="navbar-nav ms-auto">
      <a class="nav-link" href="/listings/new"><b>Add your listing</b></a>

      <% if(!currUser){ %>
        <a class="nav-link" href="/signup"><b>Sign up</b></a>
        <a class="nav-link" href="/login"><b>Log in</b></a>
      <% } %>

      <% if(currUser){ %>
        <a class="nav-link" href="/logout"><b>Log out</b></a>
      <% } %>
    </div>
  </div>
</nav>