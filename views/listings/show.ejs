<% layout('layouts/boilerplate') -%>

<div class="row mt-3">
  <div class="col-12 col-md-8 offset-md-2">
    <h3><%= listing.title %></h3>

    <div class="card show-card border-0">
      <img 
        src="<%= listing.image.url %>" 
        class="card-img-top show-img" 
        alt="listing_image"
        style="height: auto; max-height: 400px; object-fit: cover; border-radius: 1.5rem;"
      >
      <div class="card-body px-0">
        <p class="text-muted">Owned by <i><%= listing.owner.username %></i></p>
        <p><%= listing.description %></p>
        <p><strong>Price:</strong> ₹ <%= listing.price.toLocaleString("en-IN") %> / night</p>
        <p><strong>Location:</strong> <%= listing.location %>, <%= listing.country %></p>
      </div>
    </div>

    <% if(currUser && currUser._id.equals(listing.owner._id)) { %>
    <div class="d-flex gap-2 mb-4">
      <a href="/listings/<%= listing._id %>/edit" class="btn btn-warning px-4">Edit</a>
      <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
        <button class="btn btn-danger px-4">Delete</button>
      </form>
    </div>
    <% } %>

    <hr>
    <div class="mb-4">
      <h4>Where you'll be</h4>
      <div id="map" style="height: 300px; width: 100%; border-radius: 1rem;"
           data-coords="<%= JSON.stringify(listing.geometry.coordinates) %>"
           data-title="<%= listing.title %>">
      </div>
    </div>
  </div>
</div>
<script src="/js/map.js"></script>